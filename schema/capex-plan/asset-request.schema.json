{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.com/capex-plan/asset-request.schema.json",
  "title": "Asset Request",
  "description": "An individual capital-expenditure request against a Capex Budget. Matches public.asset_requests, with public.asset_request_approvals embedded as the `approvals` array. No `category` field -- dropped in migration 0023 as a duplicate of the linked Budget's own `categoryId` (asset_category).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "code", "budgetId", "title", "estimatedCost", "currency", "requestedBy", "requestDate", "statusId", "ownerId"],
  "properties": {
    "id": { "$ref": "../common.schema.json#/$defs/uuid" },
    "code": { "type": "string", "pattern": "^CAPEX-[0-9]{6}$", "examples": ["CAPEX-000042"] },
    "budgetId": { "description": "FK -> capex-plan/capex-budget.id.", "$ref": "../common.schema.json#/$defs/uuid" },
    "title": { "$ref": "../common.schema.json#/$defs/nonEmptyText" },
    "description": { "$ref": "../common.schema.json#/$defs/longText" },
    "estimatedCost": {
      "description": "Auto-follows the linked Bill of Materials' estimated total once one exists (migration 0034); otherwise entered by hand.",
      "$ref": "../common.schema.json#/$defs/money"
    },
    "currency": { "$ref": "../common.schema.json#/$defs/currency" },
    "fundingSourceId": { "description": "FK -> lookup_options.id, list_key = 'funding_source'. Nullable.", "$ref": "../common.schema.json#/$defs/lookupRef" },
    "justification": { "$ref": "../common.schema.json#/$defs/longText" },
    "priorityId": { "description": "FK -> lookup_options.id, list_key = 'asset_request_priority'. Nullable.", "$ref": "../common.schema.json#/$defs/lookupRef" },
    "requestedBy": { "$ref": "../common.schema.json#/$defs/nonEmptyText" },
    "requestDate": { "$ref": "../common.schema.json#/$defs/date" },
    "requiredByDate": { "$ref": "../common.schema.json#/$defs/date" },
    "statusId": { "description": "FK -> lookup_options.id, list_key = 'asset_request_status'.", "$ref": "../common.schema.json#/$defs/lookupRef" },
    "ownerId": { "$ref": "../common.schema.json#/$defs/uuid" },
    "approvals": {
      "description": "public.asset_request_approvals rows for this request.",
      "type": "array",
      "items": { "$ref": "#/$defs/approval" }
    },
    "createdAt": { "$ref": "../common.schema.json#/$defs/timestamp" },
    "updatedAt": { "$ref": "../common.schema.json#/$defs/timestamp" }
  },
  "$defs": {
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "assetRequestId", "level", "approverId", "decision", "decidedAt"],
      "properties": {
        "id": { "$ref": "../common.schema.json#/$defs/uuid" },
        "assetRequestId": { "$ref": "../common.schema.json#/$defs/uuid" },
        "level": { "type": "integer", "minimum": 1 },
        "approverId": { "$ref": "../common.schema.json#/$defs/nonEmptyText" },
        "approverTitle": { "$ref": "../common.schema.json#/$defs/optionalText" },
        "decision": { "type": "string", "enum": ["approved", "rejected", "delegated"] },
        "comment": { "$ref": "../common.schema.json#/$defs/optionalText" },
        "decidedAt": { "$ref": "../common.schema.json#/$defs/timestamp" }
      }
    }
  }
}
