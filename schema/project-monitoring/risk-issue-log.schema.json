{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.com/project-monitoring/risk-issue-log.schema.json",
  "title": "Risk / Issue",
  "description": "A project risk or issue. Matches public.risk_issue_log. code prefix (RISK- vs ISSUE-) is picked from typeId's resolved label at create time, since type is now a lookup_options reference rather than a plain string.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "code", "projectId", "typeId", "title", "statusId", "raisedDate", "ownerId"],
  "properties": {
    "id": { "$ref": "../common.schema.json#/$defs/uuid" },
    "code": { "type": "string", "pattern": "^(RISK|ISSUE)-[0-9]{6}$", "examples": ["RISK-000012", "ISSUE-000004"] },
    "projectId": { "description": "FK -> project-monitoring/project-charter.id.", "$ref": "../common.schema.json#/$defs/uuid" },
    "typeId": { "description": "FK -> lookup_options.id, list_key = 'risk_type' (Risk, Issue). Decides the code prefix.", "$ref": "../common.schema.json#/$defs/lookupRef" },
    "title": { "$ref": "../common.schema.json#/$defs/nonEmptyText" },
    "description": { "$ref": "../common.schema.json#/$defs/longText" },
    "categoryId": { "description": "FK -> lookup_options.id, list_key = 'risk_category'.", "$ref": "../common.schema.json#/$defs/lookupRef" },
    "probabilityId": { "description": "FK -> lookup_options.id, list_key = 'risk_probability'.", "$ref": "../common.schema.json#/$defs/lookupRef" },
    "impactId": { "description": "FK -> lookup_options.id, list_key = 'risk_impact'.", "$ref": "../common.schema.json#/$defs/lookupRef" },
    "severityId": { "description": "FK -> lookup_options.id, list_key = 'risk_severity'.", "$ref": "../common.schema.json#/$defs/lookupRef" },
    "statusId": { "description": "FK -> lookup_options.id, list_key = 'risk_status'.", "$ref": "../common.schema.json#/$defs/lookupRef" },
    "owner": { "$ref": "../common.schema.json#/$defs/optionalText" },
    "mitigationPlan": { "$ref": "../common.schema.json#/$defs/longText" },
    "contingencyPlan": { "$ref": "../common.schema.json#/$defs/longText" },
    "linkedMilestoneId": { "description": "FK -> project-monitoring/milestone.id. Exists live but not wired to the app form (pre-existing gap, flagged in SCHEMA_RESTRUCTURE.md Part 10a).", "$ref": "../common.schema.json#/$defs/uuid" },
    "raisedDate": { "$ref": "../common.schema.json#/$defs/date" },
    "dueDate": { "$ref": "../common.schema.json#/$defs/date" },
    "resolvedDate": { "$ref": "../common.schema.json#/$defs/date" },
    "ownerId": { "$ref": "../common.schema.json#/$defs/uuid" },
    "createdAt": { "$ref": "../common.schema.json#/$defs/timestamp" },
    "updatedAt": { "$ref": "../common.schema.json#/$defs/timestamp" }
  }
}
