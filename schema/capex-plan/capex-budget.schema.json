{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.com/capex-plan/capex-budget.schema.json",
  "title": "Capex Budget",
  "description": "A yearly/quarterly capital budget allocation for one department. Matches public.capex_budgets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "code", "fiscalYear", "periodId", "department", "allocatedAmount", "currency", "statusId", "ownerId"],
  "properties": {
    "id": { "$ref": "../common.schema.json#/$defs/uuid" },
    "code": { "type": "string", "pattern": "^CBUD-[0-9]{4}-[0-9]{4}$", "examples": ["CBUD-2026-0001"] },
    "fiscalYear": { "type": "integer", "minimum": 2000, "maximum": 2100 },
    "periodId": { "description": "FK -> lookup_options.id, list_key = 'budget_period' (FY, Q1-Q4).", "$ref": "../common.schema.json#/$defs/lookupRef" },
    "department": { "$ref": "../common.schema.json#/$defs/nonEmptyText" },
    "categoryId": { "description": "FK -> lookup_options.id, list_key = 'asset_category'. Nullable.", "$ref": "../common.schema.json#/$defs/lookupRef" },
    "allocatedAmount": { "$ref": "../common.schema.json#/$defs/money" },
    "committedAmount": { "$ref": "../common.schema.json#/$defs/money", "default": 0 },
    "spentAmount": { "$ref": "../common.schema.json#/$defs/money", "default": 0 },
    "currency": { "$ref": "../common.schema.json#/$defs/currency" },
    "statusId": { "description": "FK -> lookup_options.id, list_key = 'budget_status' (Draft, Proposed, Approved, Locked, Closed).", "$ref": "../common.schema.json#/$defs/lookupRef" },
    "ownerId": { "description": "FK -> auth.users.id. Row-owner for RLS.", "$ref": "../common.schema.json#/$defs/uuid" },
    "notes": { "$ref": "../common.schema.json#/$defs/optionalText" },
    "createdAt": { "$ref": "../common.schema.json#/$defs/timestamp" },
    "updatedAt": { "$ref": "../common.schema.json#/$defs/timestamp" }
  }
}
