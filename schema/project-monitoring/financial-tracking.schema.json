{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.com/project-monitoring/financial-tracking.schema.json",
  "title": "Financial Tracking",
  "description": "Planned vs. committed vs. actual cost for one period of one project. Matches public.financial_tracking, with the public.financial_tracking_pos join table (trackingId, purchaseOrderId composite PK, no other columns) surfaced as `linkedPurchaseOrderIds`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "code", "projectId", "period", "currency", "plannedCost", "committedCost", "actualCost", "ownerId"],
  "properties": {
    "id": { "$ref": "../common.schema.json#/$defs/uuid" },
    "code": { "type": "string", "pattern": "^FT-[0-9]{6}$", "examples": ["FT-000205"] },
    "projectId": { "description": "FK -> project-monitoring/project-charter.id.", "$ref": "../common.schema.json#/$defs/uuid" },
    "period": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2]|Q[1-4])$", "examples": ["2026-03", "2026-Q1"] },
    "currency": { "$ref": "../common.schema.json#/$defs/currency" },
    "plannedCost": { "$ref": "../common.schema.json#/$defs/money" },
    "committedCost": { "$ref": "../common.schema.json#/$defs/money" },
    "actualCost": { "$ref": "../common.schema.json#/$defs/money" },
    "earnedValue": { "$ref": "../common.schema.json#/$defs/money" },
    "forecastAtCompletion": { "$ref": "../common.schema.json#/$defs/money" },
    "costVariance": { "description": "earnedValue - actualCost. Read-only in the app.", "type": "number" },
    "recordedBy": { "$ref": "../common.schema.json#/$defs/optionalText" },
    "recordedAt": { "$ref": "../common.schema.json#/$defs/timestamp" },
    "ownerId": { "$ref": "../common.schema.json#/$defs/uuid" },
    "linkedPurchaseOrderIds": {
      "description": "Backed by the public.financial_tracking_pos join table.",
      "type": "array",
      "items": { "$ref": "../common.schema.json#/$defs/uuid" }
    },
    "createdAt": { "$ref": "../common.schema.json#/$defs/timestamp" },
    "updatedAt": { "$ref": "../common.schema.json#/$defs/timestamp" }
  }
}
