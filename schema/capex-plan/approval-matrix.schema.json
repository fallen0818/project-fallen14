{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.com/capex-plan/approval-matrix.schema.json",
  "title": "Approval Matrix",
  "description": "A named set of approval levels/thresholds, effective over a date range. Matches public.approval_matrices, with public.approval_matrix_levels (exclusively owned, no other consumer) embedded as the `levels` array.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "code", "currency", "effectiveFrom", "ownerId"],
  "properties": {
    "id": { "$ref": "../common.schema.json#/$defs/uuid" },
    "code": { "type": "string", "pattern": "^APPX-[0-9]{4}$", "examples": ["APPX-0001"] },
    "name": { "$ref": "../common.schema.json#/$defs/optionalText" },
    "description": { "$ref": "../common.schema.json#/$defs/optionalText" },
    "currency": { "$ref": "../common.schema.json#/$defs/currency" },
    "effectiveFrom": { "$ref": "../common.schema.json#/$defs/date" },
    "effectiveTo": { "$ref": "../common.schema.json#/$defs/date" },
    "ownerId": { "$ref": "../common.schema.json#/$defs/uuid" },
    "levels": {
      "description": "public.approval_matrix_levels rows for this matrix.",
      "type": "array",
      "items": { "$ref": "#/$defs/level" }
    },
    "createdAt": { "$ref": "../common.schema.json#/$defs/timestamp" },
    "updatedAt": { "$ref": "../common.schema.json#/$defs/timestamp" }
  },
  "$defs": {
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "matrixId", "level", "approverRole", "minAmount"],
      "properties": {
        "id": { "$ref": "../common.schema.json#/$defs/uuid" },
        "matrixId": { "$ref": "../common.schema.json#/$defs/uuid" },
        "level": { "type": "integer", "minimum": 1 },
        "approverRole": { "$ref": "../common.schema.json#/$defs/nonEmptyText" },
        "approverTitle": { "$ref": "../common.schema.json#/$defs/optionalText" },
        "minAmount": { "$ref": "../common.schema.json#/$defs/money" },
        "maxAmount": { "$ref": "../common.schema.json#/$defs/money" },
        "requiresQuorum": { "type": "integer", "minimum": 1, "default": 1 },
        "escalationRole": { "$ref": "../common.schema.json#/$defs/optionalText" }
      }
    }
  }
}
