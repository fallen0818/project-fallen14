{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.com/procurement-plan/vendor-bidding.schema.json",
  "title": "Vendor Bidding",
  "description": "A request for quotation (RFQ) against a requisition, capturing vendor quotes and their evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rfqId", "requisitionId", "issueDate", "closeDate", "status", "bids"],
  "properties": {
    "rfqId": {
      "$ref": "common.schema.json#/$defs/rfqId",
      "examples": ["RFQ-000777"]
    },
    "requisitionId": {
      "description": "FK -> procurement-plan/purchase-requisition.requisitionId.",
      "$ref": "common.schema.json#/$defs/requisitionId"
    },
    "title": { "type": "string", "maxLength": 200 },
    "issueDate": { "$ref": "common.schema.json#/$defs/date" },
    "closeDate": {
      "description": "Should be on or after issueDate; not enforced at schema level - validate in application logic.",
      "$ref": "common.schema.json#/$defs/date"
    },
    "currency": { "$ref": "common.schema.json#/$defs/currency" },
    "evaluationCriteria": {
      "description": "Weighted criteria used to score bids. Weights should sum to 1; not enforced at schema level - validate in application logic.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "weight"],
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["open", "closed", "under-evaluation", "awarded", "cancelled"]
    },
    "bids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/bid" }
    },
    "awardedVendorId": {
      "description": "Vendor selected for award; required once status is 'awarded'. Should match a bids[].vendorId - not enforced at schema level, validate in application logic.",
      "type": "string",
      "maxLength": 100
    },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": { "status": { "const": "awarded" } }
      },
      "then": { "required": ["awardedVendorId"] }
    }
  ],
  "$defs": {
    "bid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendorId", "vendorName", "totalPrice", "currency"],
      "properties": {
        "vendorId": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "vendorName": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "submittedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "totalPrice": { "$ref": "common.schema.json#/$defs/money" },
        "currency": { "$ref": "common.schema.json#/$defs/currency" },
        "leadTimeDays": { "type": "integer", "minimum": 0, "maximum": 3650 },
        "lineQuotes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["procurementItemId", "unitPrice"],
            "properties": {
              "procurementItemId": {
                "description": "FK -> procurement-plan/procurement-item.itemId.",
                "$ref": "common.schema.json#/$defs/procurementItemId"
              },
              "unitPrice": { "$ref": "common.schema.json#/$defs/money" }
            }
          }
        },
        "evaluationScore": {
          "description": "Weighted composite score (0-100).",
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "compliant": {
          "description": "Whether the bid meets mandatory requirements.",
          "type": "boolean"
        }
      }
    }
  }
}
